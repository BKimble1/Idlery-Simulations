{
  "name": "idlery-simulations",
  "private": true,
  "version": "1.0.0",
  "description": "FAB / ONE: Idlery's interactive engineering simulations (simulations.idlery.com).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "npm ci && node scripts/simulations.mjs npm ci --no-audit --no-fund",
    "dev": "vite --config site/vite.config.ts",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs dist 8888",
    "typecheck": "tsc -p site",
    "test": "node scripts/simulations.mjs npm test",
    "e2e": "playwright test",
    "e2e:photolithography": "node scripts/simulation-e2e.mjs photolithography",
    "e2e:humanoid": "node scripts/simulation-e2e.mjs humanoid",
    "capture-preview": "node scripts/capture-preview.mjs",
    "package": "node scripts/package.mjs",
    "verify-package": "node scripts/verify-package.mjs",
    "import-simulation": "node scripts/import-simulation.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
